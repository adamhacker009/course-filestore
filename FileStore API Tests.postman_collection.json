							"name": "Register",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Status 201 Created\", () => {\r",
											"    pm.response.to.have.status(200);\r",
											"    });\r",
											"        pm.test(\"Response has token\", () => {\r",
											"            const jsonData = pm.response.json();\r",
											"            pm.expect(jsonData).to.be.an('object');\r",
											"            pm.expect(jsonData.data).to.have.property('token');\r",
											"            pm.expect(jsonData.data.token.token).to.be.a('string');\r",
											"            pm.expect(jsonData.data.token.token.length).to.be.greaterThan(20);\r",
											"        });\r",
											"          pm.test(\"Content-Type is application/json\", () => {\r",
											"              pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');\r",
											"        });"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
